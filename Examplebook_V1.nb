      SubscriptBox["l", "12"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Theta]", "2"], "+", 
        SubscriptBox["\[Theta]", "1"]}], ")"}], 
      SubsuperscriptBox["\[Sigma]", "2", "z"], 
      SubsuperscriptBox["\[Tau]", "2", "z"]}]}], "]"}], 
   "."}]}]], "DisplayFormulaNumbered",
