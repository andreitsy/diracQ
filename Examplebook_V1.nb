 CellChangeTimes->{{3.5661318454214973`*^9, 3.566131854457014*^9}, {
  3.566132012396048*^9, 3.5661320149371934`*^9}, {3.566132070349363*^9, 
  3.566132074346592*^9}},ExpressionUUID->"e3b80e40-2f96-417e-8a90-\
8d08214be542"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{"2", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"t", " ", "U"}], ")"}], "**", 
     RowBox[{"f\[Dagger]", "[", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}]}], "]"}], "**", 
     RowBox[{"f\[Dagger]", "[", 
      RowBox[{"1", ",", "1"}], "]"}], "**", 
     RowBox[{"f", "[", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}]}], "]"}], "**", 
     RowBox[{"f", "[", 
      RowBox[{"3", ",", "1"}], "]"}]}]}], "-", 
   RowBox[{"2", " ", 
    RowBox[{"\[LeftSkeleton]", "1", "\[RightSkeleton]"}]}], "+", 
   RowBox[{"\[LeftSkeleton]", "44", "\[RightSkeleton]"}], "+", 
   RowBox[{"2", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"t", " ", "U"}], ")"}], "**", 
     RowBox[{"f\[Dagger]", "[", 
