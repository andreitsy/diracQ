   RowBox[{"ClusterHamiltonian", "[", 
    RowBox[{"t1_", ",", "t2_", ",", "U_"}], "]"}], "=", 
   RowBox[{"R1", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.566952567664838*^9, 3.566952594314766*^9}, {
  3.567006405808385*^9, 
  3.567006422984091*^9}},ExpressionUUID->"565a359f-a5b2-4781-be8d-\
d929c2db8345"],

