Cell[CellGroupData[{

Cell["\<\
(V)  Spins at work: Eight Vertex Model Yang - Baxter Equation\
\>", "Subsection",
 CellChangeTimes->{{3.488217865420987*^9, 3.4882178789210777`*^9}, 
   3.488220883050235*^9, {3.490453574610146*^9, 3.490453583101441*^9}, {
