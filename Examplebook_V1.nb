    RowBox[{"1", ",", " ", "1"}], "]"}], " ", "**", " ", 
   RowBox[{"f\[Dagger]", "[", 
    RowBox[{"2", ",", " ", 
     RowBox[{"-", "1"}]}], "]"}], " ", "**", " ", 
   RowBox[{"Ket", "[", "Vacuum", "]"}]}]}]], "Input",ExpressionUUID->\
"d95636fe-1fe1-4204-9973-c8bc8c8781db"],

