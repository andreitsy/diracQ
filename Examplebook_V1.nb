e2cfe16f0757"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    OverscriptBox["A", "\[RightVector]"], "[", "i", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"NCcross", "[", 
      RowBox[{
       RowBox[{
        OverscriptBox["L", "\[RightVector]"], "[", "i", "]"}], ",", " ", 
       RowBox[{
        OverscriptBox["p", "\[RightVector]"], "[", "i", "]"}]}], "]"}]}], " ",
     "-", " ", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"NCcross", "[", " ", 
      RowBox[{
       RowBox[{
        OverscriptBox["p", "\[RightVector]"], "[", "i", "]"}], ",", 
       RowBox[{
        OverscriptBox["L", "\[RightVector]"], "[", "i", "]"}]}], "]"}]}], " ",
     "+", "    ", 
    RowBox[{"Z", " ", 
     SuperscriptBox["\[ExponentialE]", "2"], " ", "m", " ", 
     FractionBox[
      RowBox[{
       OverscriptBox["q", "\[RightVector]"], "[", "i", "]"}], 
      SqrtBox[
       RowBox[{
        RowBox[{
         OverscriptBox["q", "\[RightVector]"], "[", "i", "]"}], ".", 
        RowBox[{
         OverscriptBox["q", "\[RightVector]"], "[", "i", "]"}]}]]]}]}]}], 
  ";"}]], "Input",
