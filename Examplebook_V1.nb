 RowBox[{"Short", "[", 
  RowBox[{
   RowBox[{"StandardOrderQ", "[", 
    RowBox[{"Hcluster", "**", 
     RowBox[{"\[CapitalPsi]", "[", "9", "]"}]}], "]"}], ",", "3"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.5670003857262278`*^9, 3.567000414314699*^9}, {
  3.567000530713459*^9, 
  3.5670005648429537`*^9}},ExpressionUUID->"5e771ba3-f892-4bbf-a107-\
