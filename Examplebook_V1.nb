    SubscriptBox["h", "2"], "-", 
    SubscriptBox["h", "3"]}], "]"}], " ", 
  RowBox[{"Sinh", "[", 
   RowBox[{
    SubscriptBox["h", "1"], "-", 
    SubscriptBox["h", "2"]}], "]"}], " ", 
