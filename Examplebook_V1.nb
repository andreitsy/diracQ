Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "H", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       OverscriptBox["p", "\[RightVector]"], "[", "i", "]"}], ".", 
      RowBox[{
       OverscriptBox["p", "\[RightVector]"], "[", "i", "]"}]}], 
     RowBox[{"2", "m"}]], "-", 
    RowBox[{"Z", " ", 
     FractionBox[
