Cell[TextData[StyleBox["We now apply the definition of the Boltzmann weights.",
 FontSize->12,
 FontWeight->"Plain"]], "Text",
 CellChangeTimes->{{3.488917146890625*^9, 3.48891719559375*^9}, {
   3.488917436546875*^9, 3.4889174371875*^9}, 3.489179502028809*^9, 
   3.494866910757257*^9},
 FontSize->10,
 FontWeight->"Bold",ExpressionUUID->"90670d5e-ecdb-4e54-a05c-8de8adbdd750"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rulesimplify", "=", " ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["h", "i_"], "->", 
      RowBox[{
       RowBox[{"1", "/", "2"}], 
       RowBox[{"ArcSinh", "[", 
        RowBox[{
         RowBox[{"U", "/", "2"}], " ", 
         RowBox[{"Cos", "[", 
          SubscriptBox["\[Theta]", "i"], "]"}], " ", 
         RowBox[{"Sin", "[", 
          SubscriptBox["\[Theta]", "i"], "]"}]}], "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"n_", ",", "m_", ",", "p_", ",", "q_"}], "]"}], "->", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"p", "+", 
         RowBox[{"n", " ", "q"}]}], "]"}], "+", 
       RowBox[{"m", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"p", "+", 
          RowBox[{"n", " ", "q"}]}], "]"}]}]}]}]}], "}"}]}], ";"}]], "Input",E\
xpressionUUID->"3ccd5bb2-38a9-44d3-9c68-800aea911ed9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"sum", "[", "1", "]"}], "/.", "rulesimplify"}], "]"}]], "Input",Exp\
ressionUUID->"4b25fc32-ffe1-4e35-b565-75f0699a79a4"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{
  3.566134325512351*^9},ExpressionUUID->"b2a60277-7186-43ba-8dde-\
ae65dc5a469d"]
}, Closed]],

Cell["\<\
We see that the coefficients of this one string of operators simplify to \
zero. We must show that each such term vanishes for all 472 strings of \
operators. The command below will evaluate each such term. \
\>", "Text",
 CellChangeTimes->{{3.494865817235071*^9, 3.494865933144792*^9}, {
  3.565733076994487*^9, 3.565733125090851*^9}, {3.565734007323831*^9, 
  3.565734010034779*^9}, {3.5661343623644586`*^9, 
  3.5661343875719004`*^9}},ExpressionUUID->"83f21649-b1a3-4701-a4f9-\
db9fc8d14b5e"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"sum", "[", "i", "]"}], "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"QCoefficient", "[", 
       RowBox[{"organizedsubtraction", ",", 
        RowBox[{"OperatorTerms", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"OrganizedExpression", "\[Rule]", "True"}]}], "]"}], "/.", 
      "rulesimplify"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "472"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.566134393112217*^9, 
  3.5661344055049257`*^9}},ExpressionUUID->"e9ad15cf-7f27-4262-802b-\
8af9e2459df3"],

