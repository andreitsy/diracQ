14c62f6a6e88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"siml", "[", "a_", "]"}], ":=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"pppl", "[", "a", "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"NonCommutativeMultiply", "\[Rule]", "Times"}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.5271714235389214`*^9, 
  3.527171428522789*^9}},ExpressionUUID->"7892858e-745a-4393-bf43-\
a81f7d861b83"],

