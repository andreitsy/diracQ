 RowBox[{
  SuperscriptBox[
   RowBox[{"A", "[", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1", ",", 
     SubscriptBox["\[Theta]", "1"], ",", 
     SubscriptBox["\[Theta]", "3"]}], "]"}], "2"], " ", 
