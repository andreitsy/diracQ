     RowBox[{"2", ",", 
      RowBox[{"-", "1"}]}], "]"}], "**", 
    RowBox[{"f\[Dagger]", "[", 
     RowBox[{"3", ",", 
      RowBox[{"-", "1"}]}], "]"}], "**", 
    RowBox[{"f\[Dagger]", "[", 
     RowBox[{"1", ",", "1"}], "]"}], "**", 
    RowBox[{"f\[Dagger]", "[", 
     RowBox[{"3", ",", "1"}], "]"}], "**", 
    TemplateBox[{"Vacuum"},
     "Ket"]}]}],
