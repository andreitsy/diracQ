      RowBox[{"i", ",", "z"}], "]"}], "2"]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"q", "[", 
        RowBox[{"i", ",", "x"}], "]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"q", "[", 
        RowBox[{"i", ",", "y"}], "]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"q", "[", 
        RowBox[{"i", ",", "z"}], "]"}], "2"]}], ")"}], 
    RowBox[{"3", "/", "2"}]]], "+", 
  FractionBox[
   RowBox[{"\[ImaginaryI]", " ", 
    SuperscriptBox["\[ExponentialE]", "2"], " ", "Z", " ", "\[HBar]", " ", 
    RowBox[{"p", "[", 
     RowBox[{"i", ",", "z"}], "]"}]}], 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"q", "[", 
       RowBox[{"i", ",", "x"}], "]"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"q", "[", 
       RowBox[{"i", ",", "y"}], "]"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"q", "[", 
       RowBox[{"i", ",", "z"}], "]"}], "2"]}]]]}]], "Output",
 CellChangeTimes->{3.524510966235914*^9, 3.5271713758832417`*^9, 
  3.530413044236773*^9, 3.5652724051645813`*^9, 
  3.5659981549688997`*^9},ExpressionUUID->"1fa56ef2-c550-4a6f-bbcc-\
594783c0c65e"]
}, Closed]],

