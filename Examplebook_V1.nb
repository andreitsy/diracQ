Cell[BoxData[
 RowBox[{"4", " ", 
  RowBox[{"A", "[", 
   RowBox[{
    RowBox[{"-", "1"}], ",", 
    RowBox[{"-", "1"}], ",", 
    SubscriptBox["\[Theta]", "2"], ",", 
    SubscriptBox["\[Theta]", "3"]}], "]"}], " ", 
  RowBox[{"A", "[", 
   RowBox[{"1", ",", 
    RowBox[{"-", "1"}], ",", 
    SubscriptBox["\[Theta]", "1"], ",", 
    SubscriptBox["\[Theta]", "3"]}], "]"}], " ", 
  RowBox[{"Cos", "[", 
   RowBox[{
    SubscriptBox["\[Theta]", "1"], "-", 
    SubscriptBox["\[Theta]", "2"]}], "]"}], " ", 
  RowBox[{"Cos", "[", 
   RowBox[{
    SubscriptBox["\[Theta]", "1"], "-", 
    SubscriptBox["\[Theta]", "3"]}], "]"}], " ", 
  RowBox[{"Cos", "[", 
