   SubscriptBox["S", "12"], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["W", "2"], "|", 
     SubscriptBox["W", "1"]}], ")"}]}], "=", 
  RowBox[{
   RowBox[{"\[Rho]", "[", 
    RowBox[{
     RowBox[{"cos", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Theta]", "2"], "+", 
        SubscriptBox["\[Theta]", "1"]}], ")"}], "cos", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["h", "2"], "-", 
        SubscriptBox["h", "1"]}], ")"}], 
      SubscriptBox["l", "12"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Theta]", "2"], "-", 
        SubscriptBox["\[Theta]", "1"]}], ")"}]}], "+", 
     RowBox[{"cos", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Theta]", "2"], "-", 
        SubscriptBox["\[Theta]", "1"]}], ")"}], "sinh", 
      RowBox[{"(", 
